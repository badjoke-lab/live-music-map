{
  "youtube": {
    "configured": true,
    "mode": "youtube_data_api_v3_plus_official_atom_feed",
    "strategy": "atom_feed_delta_plus_known_active_video_poll",
    "search_list_used": false,
    "atom_feed_quota_units": 0,
    "poll_cadence_minutes": 15,
    "playlist_backstop": "daily",
    "playlist_backstop_recent_videos": 25,
    "music_live_classifier_version": 1,
    "public_stream_rule": "music_live_status=verified",
    "rss_failure_fallback": {
      "enabled": false,
      "superseded_by": "rolling_playlist_sweep"
    },
    "rolling_playlist_sweep": {
      "enabled": true,
      "cadence_minutes": 15,
      "max_playlist_calls_per_run": 75,
      "recent_videos_per_source": 50,
      "selection": "oldest_checked_first",
      "source_count": 140,
      "projected_max_full_sweep_minutes": 30,
      "playlist_404_repair": "channels.contentDetails_then_single_retry",
      "playlist_calls_last_run": 75,
      "channel_repair_calls_last_run": 0,
      "repaired_playlists_last_run": 0
    }
  }
}
